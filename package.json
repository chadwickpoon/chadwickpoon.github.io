  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "8.5.25",
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "@playwright/test": "1.63.0"
  }
